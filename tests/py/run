#!/bin/sh
# Mantel Link's Python tests (pytest + Home Assistant's own test harness), in
# the same venv as HK Frontend's (outside the repo; built on first use).
# HK_FRONTEND_COMPONENT=<a built custom_components/hk_frontend> also runs the
# hand-over tests against the real HK Frontend; MANTEL_ROOT=<a Mantel checkout>
# the end-to-end ones against Mantel's real endpoint. The Mantel repository's
# tests/test_mantel_link.py sets both.
VENV="$HOME/.venvs/hk-ha-test"
[ -x "$VENV/bin/pytest" ] || { python3 -m venv "$VENV" && "$VENV/bin/pip" install -q pytest-homeassistant-custom-component; } || exit 1
cd "$(dirname "$0")" && exec "$VENV/bin/pytest" -q -p no:cacheprovider "$@"
